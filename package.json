{
  "name": "vera-app",
  "version": "1.0.0",
  "description": "Vera built with Cloudflare's Worker AI.",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo start --android",
    "build": "tsc",
    "build:web": "expo export --platform web",
    "check": "tsc && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "EXPO_NO_TELEMETRY=1 expo start --web",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "predeploy": "wrangler d1 migrations apply vera-app --remote",
    "seedLocalD1": "wrangler d1 migrations apply vera-app --local",
    "start": "EXPO_NO_TELEMETRY=1 expo start --clear",
    "types": "wrangler types",
    "web": "expo start --web"
  },
  "dependencies": {
    "@cloudflare/ai": "^1.0.22",
    "@expo/vector-icons": "^14.1.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^1.22.3",
    "@react-native-community/datetimepicker": "^7.6.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/auth-helpers-react": "^0.5.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/realtime-js": "^2.11.8",
    "@supabase/supabase-js": "^2.39.8",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^2.0.0",
    "expo": "^53.0.0",
    "expo-auth-session": "~6.1.3",
    "expo-blur": "~14.1.3",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.3",
    "expo-crypto": "~14.1.3",
    "expo-font": "~13.2.2",
    "expo-haptics": "~14.1.3",
    "expo-linear-gradient": "~14.1.3",
    "expo-linking": "~7.1.3",
    "expo-router": "~5.0.2",
    "expo-splash-screen": "~0.30.6",
    "expo-status-bar": "~2.2.2",
    "expo-symbols": "~0.4.3",
    "expo-system-ui": "~5.0.5",
    "expo-web-browser": "~14.1.5",
    "langchain": "^0.1.28",
    "lucide-react-native": "^0.475.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.3.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@cloudflare/workers-types": "^4.20250204.0",
    "@types/react": "~19.0.10",
    "supabase": "^2.23.4",
    "supabase-cli": "^0.0.21",
    "typescript": "~5.8.3",
    "wrangler": "^4.15.2"
  }
}